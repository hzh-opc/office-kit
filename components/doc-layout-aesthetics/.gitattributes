# 跨平台换行规范：文本文件统一 LF，避免 Windows CRLF 污染 diff
* text=auto eol=lf

# 明确标记文本文件（按扩展名，保证 eol=lf 生效）
*.md   text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.swift text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.ps1  text eol=lf
*.css  text eol=lf
*.html text eol=lf

# 二进制文件：不进行换行转换、不 diff 文本化
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.pdf  binary
*.docx binary
*.pptx binary
*.xlsx binary
*.zip  binary
*.ttf  binary
*.otf  binary
*.ttc  binary
*.woff binary
*.woff2 binary
