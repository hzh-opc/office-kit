# 虚拟环境（按机器用 uv 重建，不入库）
.venv/

# Python 缓存
__pycache__/
*.pyc

# 工作台运行产物（忽略内容，但保留 .gitkeep 以固化目录结构）
workbench/**
!workbench/**/
!workbench/**/.gitkeep

# 本地密钥/配置（按需填写，不入库）
config/.env
*.key

# 编辑/系统文件
.DS_Store

# 组件运行时缓存/测试残留（不入库）
components/**/_verify_cache_test.bin
components/**/scripts/.cache_verify/

# 工作流运行时状态（dry-run/运行产生，不入库）
workflows/**/_state/
