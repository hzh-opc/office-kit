#!/bin/sh
# office-kit git 包装器（可选）
#
# office-kit git 包装器
#
# 环境对 .git 工作树的 git 写操作施加了 lock 写保护（index.lock 无法 unlink）；
# 本脚本统一加 --no-optional-locks 以绕过该写保护，并避免误用宿主全局 git 配置。
#
# 用法：./ogit <任意 git 子命令>
# 例：  ./ogit status
#       ./ogit add -A
#       ./ogit commit -m "feat: ..."
exec git --no-optional-locks "$@"
