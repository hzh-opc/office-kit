#!/bin/sh
# office-kit git 包装器（可选）
#
# ~/office-kit 已是含真实 .git 的本地仓库，且仓库级配置 core.optionalLocks=false，
# 因此普通 git 即可正常工作。本脚本保留为统一入口，显式加 --no-optional-locks 以兼容
# 个别仍走锁的路径，并避免误用宿主全局 git 配置。
#
# 用法：./ogit <任意 git 子命令>
# 例：  ./ogit status
#       ./ogit add -A
#       ./ogit commit -m "feat: ..."
exec git --no-optional-locks "$@"
