# office-kit 本地配置样例（复制为 .env 后按本机填写，.env 不入库）
# 工作台根目录（默认 <office-kit>/workbench，按业务流程阶段组织）
OFFICE_KIT_WORKBENCH=~/office-kit/workbench

# 本地密钥文件路径（info-extract 等需鉴权组件读取；请勿写入对话/仓库）
HZH_AGENT_KEY_PATH=~/.workbuddy/.../hzh-agent-key

# 可选：显式指定工具包根目录（跨机器迁移时若目录名变化可在此覆盖自动探测）
# OFFICE_KIT_ROOT=~/office-kit
